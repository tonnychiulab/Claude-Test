#. Plugin Name of the plugin
msgid "Unauthorized Access Tracker"
msgstr "不正アクセストラッカー"

#. Plugin Description
msgid "Detects and logs unauthorized WordPress admin access, including brute-force attempts and off-hours admin logins."
msgstr "ブルートフォース攻撃や時間外の管理者ログインを含む、不正な WordPress 管理画面へのアクセスを検出・記録します。"

#: includes/class-wuat-alerter.php
#, php-format
msgctxt "Email subject for brute-force alert. %s = site name."
msgid "[%s] Security Alert: Brute-Force Attack Detected"
msgstr "[%s] セキュリティ警告：ブルートフォース攻撃を検出"

#: includes/class-wuat-alerter.php
msgid "Brute-Force Attack Detected"
msgstr "ブルートフォース攻撃を検出"

#: includes/class-wuat-alerter.php
